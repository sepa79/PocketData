# Set an official PH auth ingress reachable from inside the container.
# Optional published image for pull/up --no-build; empty keeps the local build tag.
POCKETDATA_IMAGE=
# For a local PH Docker stack see compose.ph.yaml and docs/AUTH.md.
POCKETHIVE_AUTH_BASE_URL=
# Opt in only for an approved remote HTTP public PH issuer; HTTPS/loopback need no exception.
POCKETHIVE_ALLOW_REMOTE_HTTP=false
# Additional exact MCP authorities (e.g. pd.lab:8785); localhost is built in.
POCKETDATA_MCP_ALLOWED_HOSTS=
# Only for browser MCP clients; native agents omit Origin. This does not enable CORS.
POCKETDATA_MCP_ALLOWED_ORIGINS=
# Required: the exact Redis endpoint and database used by the selected PH environment.
# Example: redis://pockethive-redis-1:6379/0 on that container's Docker network.
# Never use the ambiguous hostname redis when joining multiple project networks.
POCKETDATA_REDIS_URL=
# Optional public browser URL for the Redis Commander inspecting that same Redis/database.
# Example: http://localhost:8081/ (not a Docker hostname). Empty hides the link.
POCKETDATA_REDIS_COMMANDER_URL=
# Explicit existing PH networks; see docs/REDIS.md. They may be the same network.
COMPOSE_FILE=compose.yaml:compose.ph.yaml
POCKETHIVE_NETWORK_NAME=
POCKETHIVE_REDIS_NETWORK_NAME=
