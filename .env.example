# Set an official PH auth ingress reachable from inside the container.
# For a local PH Docker stack see compose.ph.yaml and docs/AUTH.md.
POCKETHIVE_AUTH_BASE_URL=
# Required: the exact Redis endpoint and database used by the selected PH environment.
# Example: redis://pockethive-redis-1:6379/0 on that container's Docker network.
# Never use the ambiguous hostname redis when joining multiple project networks.
POCKETDATA_REDIS_URL=
# Explicit existing PH networks; see docs/REDIS.md. They may be the same network.
COMPOSE_FILE=compose.yaml:compose.ph.yaml
POCKETHIVE_NETWORK_NAME=
POCKETHIVE_REDIS_NETWORK_NAME=
